# Feishu bot webhook
FEISHU_WEBHOOK=

# Optional Feishu app bot direct-message mode (takes precedence only when webhook is empty)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# Optional Tushare Pro token for realtime fallback and historical K-lines
TUSHARE_TOKEN=

# Runtime timezone
TIMEZONE=Asia/Shanghai

# Market data timeout seconds
MARKET_API_TIMEOUT=10
